# hustrun QQ 机器人配置（复制为 bot.env，chmod 600）。
# 凭证来自 QQ 开放平台机器人（q.qq.com），不是 QQ 账号密码。

EASYBOT_APP_ID=
EASYBOT_APP_SECRET=

# 只接受私聊（C2C）。机器人只注册了 on_c2c_message，群/频道消息不会响应。
IS_PRIVATE=1
IS_SANDBOX=0

# 首次私聊时用配对码把自己的 openid 绑成所有者；绑定信息存 users.json。
# 如果平台下发了 union_user_account（QQ 号）且等于 OWNER_QQ，会自动绑定。
OWNER_QQ=
BIND_CODE=

# CAS 登录用。留空时，第一次“登录”会在私聊里问学号和密码，
# 登录成功后写入 cas.json（600），不会写日志。
CAS_USERNAME=
CAS_PASSWORD=

SERVER_URL=https://petzjk.hust.edu.cn/cgapp-server

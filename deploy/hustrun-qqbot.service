[Unit]
Description=HUST sports QQ bot (easybot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hustrun
Group=hustrun
WorkingDirectory=/opt/hustrun
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
# 目录布局默认就是仓库本身；换成别的布局时打开下面几行
#Environment=HUSTRUN_ROOT=/opt/hustrun
#Environment=HUSTRUN_APP_DIR=/opt/hustrun/app
#Environment=HUSTRUN_QQBOT_DIR=/opt/hustrun/qqbot
#Environment=HUSTRUN_USER_ROOT=/opt/hustrun/users
#Environment=HUSTRUN_LOG_DIR=/var/log/hustrun
#Environment=HUSTRUN_PYTHON=/opt/hustrun/venv/bin/python
ExecStartPre=/usr/bin/mkdir -p /opt/hustrun/logs /opt/hustrun/logs/users
ExecStart=/opt/hustrun/venv/bin/python /opt/hustrun/qqbot/bot.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/hustrun/logs/qqbot.log
StandardError=append:/opt/hustrun/logs/qqbot.log

[Install]
WantedBy=multi-user.target
